# ==========================================
# SIPATUH Backend Environment Variables Template
# JANGAN MENYIMPAN KREDENSIAL/SECRET NYATA DI SINI
# ==========================================

# Server Configuration
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# Primary Database (sipatuh) - READ/WRITE
DATABASE_URL="mysql://user:password@localhost:3306/sipatuh"

# External Database (egov) - READ-ONLY (No migration, no writes)
EGOV_DATABASE_URL="mysql://egov_ro_user:password@localhost:3306/egov"

# External Database (simpeg) - READ-ONLY (No migration, no writes)
SIMPEG_DATABASE_URL="mysql://simpeg_ro_user:password@localhost:3306/simpeg"

# Authentication & Session Cookies (Secrets minimal 32 karakter pada produksi)
JWT_ACCESS_SECRET=ganti_dengan_jwt_access_secret_yang_sangat_kuat_32char
JWT_REFRESH_SECRET=ganti_dengan_jwt_refresh_secret_yang_sangat_kuat_32char
COOKIE_SECRET=ganti_dengan_cookie_secret_yang_sangat_kuat_32char
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# File Storage Configuration
UPLOAD_DIR=uploads

# TTE - API Gateway Esign Konsel (BSrE Kab. Konawe Selatan)
# Panduan: <TTE_GATEWAY_URL>/admin/guide, Swagger: <TTE_GATEWAY_URL>/docs
# Base URL tanpa path (tanpa /docs atau /api).
TTE_GATEWAY_URL=https://esignkonsel.konaweselatankab.go.id
# Kredensial aplikasi dari admin gateway (awalan konsel_... dan sign_...).
# Bukan akun dashboard atau kredensial server TTE. Jangan commit nilai asli.
TTE_CLIENT_ID=
TTE_CLIENT_SECRET=
# Scope dipisahkan spasi. Kosongkan untuk memakai semua scope kredensial.
TTE_SCOPE=gateway:read sign:create sign:read document:download
# Isi hanya jika admin membatasi URL aplikasi (format https://host tanpa path).
TTE_ORIGIN=
TTE_REQUEST_TIMEOUT_MS=90000
# 25 MiB sesuai batas gateway saat ini.
TTE_MAX_PDF_BYTES=26214400
# Tepat 1 karakter terlihat; dicetak sebagai marker posisi tanda tangan di PDF.
TTE_SIGNATURE_TAG=$
