# ==========================================
# SIPATUH Backend Environment Variables Template
# JANGAN MENYIMPAN KREDENSIAL/SECRET NYATA DI SINI
# ==========================================

# Server Configuration
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# Primary Database (sipatuh) - READ/WRITE
DATABASE_URL="mysql://user:password@localhost:3306/sipatuh"

# External Database (egov) - READ-ONLY (No migration, no writes)
EGOV_DATABASE_URL="mysql://egov_ro_user:password@localhost:3306/egov"

# External Database (simpeg) - READ-ONLY (No migration, no writes)
SIMPEG_DATABASE_URL="mysql://simpeg_ro_user:password@localhost:3306/simpeg"

# Authentication & Session Cookies (Secrets minimal 32 karakter pada produksi)
JWT_ACCESS_SECRET=ganti_dengan_jwt_access_secret_yang_sangat_kuat_32char
JWT_REFRESH_SECRET=ganti_dengan_jwt_refresh_secret_yang_sangat_kuat_32char
COOKIE_SECRET=ganti_dengan_cookie_secret_yang_sangat_kuat_32char
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# File Storage Configuration
UPLOAD_DIR=uploads

# TTE Wrapper Configuration (Konawe Selatan eSign Wrapper)
TTE_API_URL=https://esign-wrapper.konawe-selatan.local/api/sign
TTE_API_TOKEN=ganti_dengan_token_shared_tte_wrapper
TTE_REQUEST_TIMEOUT_MS=30000
TTE_MAX_PDF_BYTES=7000000
TTE_SIGNATURE_TAG=#tagTTD#
